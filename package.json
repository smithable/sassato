{
  "name": "sassato",
  "version": "0.1.2",
  "description": "Local-first agent state sync and task organizer",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.13.0"
  },
  "bin": {
    "sassato": "bin/sassato.js",
    "sas": "bin/sassato.js"
  },
  "files": [
    "bin",
    "dist",
    "docs/commands.md",
    "docs/architecture.md",
    "docs/permissions.md",
    "docs/integrations.md",
    "docs/benchmark.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "examples/team.config.json",
    "examples/AGENTS.md.example",
    "examples/CLAUDE.md.example",
    "examples/claude-hook.mjs",
    "examples/claude-settings.example.json",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/configuration.md",
    "docs/compatibility.md",
    "docs/context-management.md",
    "docs/provider-capabilities.md",
    "docs/managed-recovery-validation.md",
    "docs/provider-capability-evidence.json",
    "examples/recovery-evidence.example.json"
  ],
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc && node scripts/build-info.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build && node --test --test-concurrency=3 test/*.test.mjs",
    "bench": "npm run build && node scripts/benchmark.mjs",
    "smoke": "npm run build && node scripts/pack-smoke.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smithable/sassato.git"
  },
  "homepage": "https://github.com/smithable/sassato#readme",
  "bugs": {
    "url": "https://github.com/smithable/sassato/issues"
  },
  "keywords": [
    "cli",
    "agents",
    "coordination",
    "sqlite",
    "local-first"
  ]
}

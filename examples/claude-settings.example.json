{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node /ABSOLUTE/PATH/TO/sassato/examples/claude-hook.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /ABSOLUTE/PATH/TO/sassato/examples/claude-hook.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
